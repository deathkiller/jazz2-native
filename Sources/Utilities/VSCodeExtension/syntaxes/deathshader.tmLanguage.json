{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Death™ Shader",
	"scopeName": "source.deathshader",
	"fileTypes": [
		"shader",
		"inc"
	],
	"comment": "A .shader file holds two languages that overlap by name and not by meaning: the GLSL stages, and the fixed-function DSL of a `fixed_function` block. The block is therefore a real begin/end rule with its own vocabulary and its own maths subset, and it counts braces (see #fixed-function-block) so that a nested if/for cannot end it early. Everything a `.inc` fragment can carry outside a block - it is pasted textually into one - is written so that it is unambiguous on its own, which is why the fixed-function vocabulary is reachable at the top level too.",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#version-error"
		},
		{
			"include": "#preprocessor"
		},
		{
			"include": "#directives"
		},
		{
			"include": "#entry-points"
		},
		{
			"include": "#fixed-function-vocabulary"
		},
		{
			"include": "#declarations"
		},
		{
			"include": "#code"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.deathshader",
					"begin": "//",
					"end": "$"
				},
				{
					"name": "comment.block.deathshader",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"version-error": {
			"comment": "The engine injects the #version header itself - writing one in a .shader file is an error",
			"match": "^\\s*(#\\s*version)\\b.*$",
			"name": "invalid.illegal.version-directive.deathshader"
		},
		"preprocessor": {
			"patterns": [
				{
					"comment": "#include \"relative/path\" - expanded textually before parsing",
					"match": "^\\s*(#\\s*include)\\s+(\"[^\"]*\")",
					"captures": {
						"1": {
							"name": "keyword.control.directive.include.deathshader"
						},
						"2": {
							"name": "string.quoted.double.include.deathshader"
						}
					}
				},
				{
					"comment": "Compile-time conditionals resolved by the compiler - the #ifdef/#ifndef form",
					"match": "^\\s*(#\\s*(?:ifdef|ifndef))\\s+(VERTEX_STAGE|FRAGMENT_STAGE|SOFTWARE_RENDERER|NO_DYNAMIC_BRANCHING|LOW_POWER_GPU)\\b",
					"captures": {
						"1": {
							"name": "keyword.control.directive.conditional.deathshader"
						},
						"2": {
							"name": "support.constant.stage-macro.deathshader"
						}
					}
				},
				{
					"comment": "Defining or undefining one of them is a hard error - the compiler resolves them. Only the macro being DEFINED counts, so a define whose replacement merely mentions one stays legal.",
					"match": "^\\s*(#\\s*(?:define|undef))\\s+(VERTEX_STAGE|FRAGMENT_STAGE|SOFTWARE_RENDERER|NO_DYNAMIC_BRANCHING|LOW_POWER_GPU)\\b",
					"name": "invalid.illegal.stage-macro-form.deathshader",
					"captures": {
						"1": {
							"name": "keyword.control.directive.deathshader"
						}
					}
				},
				{
					"match": "^\\s*(#\\s*(?:define|undef))\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "keyword.control.directive.define.deathshader"
						},
						"2": {
							"name": "entity.name.function.preprocessor.deathshader"
						}
					}
				},
				{
					"comment": "#if / #elif expressions, where several compile-time macros can share one directive - which is how a .shader writes every conditional. The \\b after if/elif is what keeps #ifdef out of this rule.",
					"begin": "^\\s*(#\\s*(?:if|elif))\\b",
					"end": "$",
					"name": "meta.preprocessor.conditional.deathshader",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.directive.conditional.deathshader"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"match": "\\b(VERTEX_STAGE|FRAGMENT_STAGE|SOFTWARE_RENDERER|NO_DYNAMIC_BRANCHING|LOW_POWER_GPU)\\b",
							"name": "support.constant.stage-macro.deathshader"
						},
						{
							"match": "\\bdefined\\b",
							"name": "keyword.other.defined.deathshader"
						},
						{
							"include": "#numbers"
						},
						{
							"include": "#operators"
						}
					]
				},
				{
					"match": "^\\s*(#\\s*(?:ifdef|ifndef|else|endif|error|pragma|line|extension))\\b",
					"captures": {
						"1": {
							"name": "keyword.control.directive.deathshader"
						}
					}
				}
			]
		},
		"directives": {
			"comment": "Top-level keyword directives, legal at brace depth 0 and terminated by ';'. The terminator is optional in most of them so that a half-typed line still colours; `precision` is the exception, because only the two-token form ending in ';' is a directive at all.",
			"patterns": [
				{
					"comment": "program <Name>; - required, exactly once, before every other directive",
					"match": "^\\s*(program)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(;)?",
					"captures": {
						"1": {
							"name": "keyword.other.directive.program.deathshader"
						},
						"2": {
							"name": "entity.name.type.program.deathshader"
						},
						"3": {
							"name": "punctuation.terminator.deathshader"
						}
					}
				},
				{
					"comment": "batched <Name>; - canvas_item only, emits the batched twin program",
					"match": "^\\s*(batched)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(;)?",
					"captures": {
						"1": {
							"name": "keyword.other.directive.batched.deathshader"
						},
						"2": {
							"name": "entity.name.type.program.deathshader"
						},
						"3": {
							"name": "punctuation.terminator.deathshader"
						}
					}
				},
				{
					"comment": "shader_type canvas_item|custom;",
					"match": "^\\s*(shader_type)\\b(?:\\s+(?:(canvas_item|custom)\\b|([A-Za-z_][A-Za-z0-9_]*)))?\\s*(;)?",
					"captures": {
						"1": {
							"name": "keyword.other.directive.shader-type.deathshader"
						},
						"2": {
							"name": "constant.language.shader-type.deathshader"
						},
						"3": {
							"name": "invalid.illegal.shader-type.deathshader"
						},
						"4": {
							"name": "punctuation.terminator.deathshader"
						}
					}
				},
				{
					"comment": "variant <NAME>; - one extra program variant compiled with #define <NAME> (1)",
					"match": "^\\s*(variant)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(;)?",
					"captures": {
						"1": {
							"name": "keyword.other.directive.variant.deathshader"
						},
						"2": {
							"name": "entity.name.constant.variant.deathshader"
						},
						"3": {
							"name": "punctuation.terminator.deathshader"
						}
					}
				},
				{
					"comment": "render_mode <mode>[, <mode>]; - the end alternation also takes the end of the line, so a directive still missing its ';' cannot paint the rest of the file as an unknown mode",
					"begin": "^\\s*(render_mode)\\b",
					"beginCaptures": {
						"1": {
							"name": "keyword.other.directive.render-mode.deathshader"
						}
					},
					"end": "(;)|$",
					"endCaptures": {
						"1": {
							"name": "punctuation.terminator.deathshader"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"match": "\\b(blend_mix|blend_add|blend_sub|blend_mul|blend_premul_alpha|unshaded)\\b",
							"name": "constant.language.render-mode.deathshader"
						},
						{
							"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
							"name": "invalid.illegal.render-mode.deathshader"
						},
						{
							"match": ",",
							"name": "punctuation.separator.deathshader"
						}
					]
				},
				{
					"comment": "precision mediump|highp; - the two-token form is a directive (with a type it is plain GLSL, which is why the ';' has to follow the qualifier immediately)",
					"match": "^\\s*(precision)\\s+(?:(mediump|highp)|([A-Za-z_][A-Za-z0-9_]*))\\s*(;)",
					"captures": {
						"1": {
							"name": "keyword.other.directive.precision.deathshader"
						},
						"2": {
							"name": "constant.language.precision.deathshader"
						},
						"3": {
							"name": "invalid.illegal.precision.deathshader"
						},
						"4": {
							"name": "punctuation.terminator.deathshader"
						}
					}
				},
				{
					"comment": "attribute [layout(location = N)] <decl>; - a vertex attribute (vertex stage only)",
					"match": "^\\s*(attribute)\\b",
					"captures": {
						"1": {
							"name": "keyword.other.directive.attribute.deathshader"
						}
					}
				},
				{
					"comment": "varying [flat] [precision] <type> <name>; - an out/in pair across the two stages",
					"match": "^\\s*(varying)\\b(?:\\s+(flat|smooth|noperspective|centroid))?",
					"captures": {
						"1": {
							"name": "keyword.other.directive.varying.deathshader"
						},
						"2": {
							"name": "storage.modifier.interpolation.deathshader"
						}
					}
				},
				{
					"comment": "uniform <type> <name> : <hint>[, <hint>]; - the hint list is reachable ONLY from here. Anchoring it to a line that opens with `uniform`, and forbidding ';' and ':' before the separator, is what keeps an ordinary ternary (`a ? b : c;`) out of it.",
					"begin": "^\\s*(uniform)\\b([^;:]*?)(:)",
					"beginCaptures": {
						"1": {
							"name": "storage.modifier.uniform.deathshader"
						},
						"2": {
							"patterns": [
								{
									"include": "#code"
								}
							]
						},
						"3": {
							"name": "punctuation.separator.hint.deathshader"
						}
					},
					"end": "(?=;)|$",
					"patterns": [
						{
							"include": "#uniform-hints"
						}
					]
				},
				{
					"match": "^\\s*(uniform)\\b",
					"captures": {
						"1": {
							"name": "storage.modifier.uniform.deathshader"
						}
					}
				}
			]
		},
		"uniform-hints": {
			"comment": "texture_unit(N) is the only hint reflection keeps; the rest are parsed and dropped, and anything else is a compile error",
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"match": "\\b(texture_unit)\\s*(\\()\\s*(\\d+)\\s*(\\))",
					"captures": {
						"1": {
							"name": "support.function.hint.texture-unit.deathshader"
						},
						"2": {
							"name": "punctuation.section.parens.begin.deathshader"
						},
						"3": {
							"name": "constant.numeric.deathshader"
						},
						"4": {
							"name": "punctuation.section.parens.end.deathshader"
						}
					}
				},
				{
					"match": "\\b(hint_range)\\s*(\\()([^)]*)(\\))",
					"captures": {
						"1": {
							"name": "support.function.hint.deathshader"
						},
						"2": {
							"name": "punctuation.section.parens.begin.deathshader"
						},
						"3": {
							"name": "constant.numeric.deathshader"
						},
						"4": {
							"name": "punctuation.section.parens.end.deathshader"
						}
					}
				},
				{
					"match": "\\b(source_color|filter_nearest|filter_linear|repeat_enable|repeat_disable)\\b",
					"name": "support.function.hint.deathshader"
				},
				{
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
					"name": "invalid.illegal.hint.deathshader"
				},
				{
					"match": ",",
					"name": "punctuation.separator.deathshader"
				}
			]
		},
		"declarations": {
			"patterns": [
				{
					"comment": "layout (std140) uniform <Block> { ... }; / attribute layout(location = N) ...",
					"begin": "\\b(layout)\\s*(\\()",
					"beginCaptures": {
						"1": {
							"name": "storage.modifier.layout.deathshader"
						},
						"2": {
							"name": "punctuation.section.parens.begin.deathshader"
						}
					},
					"end": "(\\))|$",
					"endCaptures": {
						"1": {
							"name": "punctuation.section.parens.end.deathshader"
						}
					},
					"patterns": [
						{
							"match": "\\b(std140|std430|location|binding|set|column_major|row_major)\\b",
							"name": "support.constant.layout.deathshader"
						},
						{
							"include": "#numbers"
						},
						{
							"match": "[=,]",
							"name": "punctuation.separator.deathshader"
						}
					]
				},
				{
					"match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "storage.type.struct.deathshader"
						},
						"2": {
							"name": "entity.name.type.struct.deathshader"
						}
					}
				},
				{
					"comment": "A helper function definition. Anchored to column 0 - every global in this language is - so that a local declaration inside a body can never be mistaken for one.",
					"match": "^(void|bool|int|uint|float|double|vec2|vec3|vec4|bvec2|bvec3|bvec4|ivec2|ivec3|ivec4|uvec2|uvec3|uvec4|mat2|mat3|mat4|mat2x2|mat2x3|mat2x4|mat3x2|mat3x3|mat3x4|mat4x2|mat4x3|mat4x4)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
					"captures": {
						"1": {
							"name": "storage.type.deathshader"
						},
						"2": {
							"name": "entity.name.function.deathshader"
						}
					}
				}
			]
		},
		"entry-points": {
			"patterns": [
				{
					"comment": "The fixed-function pass list of the console backends, transpiled to C++ (never part of the GLSL stages). The body is a block rule so that the DSL vocabulary applies to the whole of it; #fixed-function-block below counts the braces of a nested if/for so that their closing brace cannot end it early.",
					"begin": "^\\s*(void)\\s+(fixed_function)\\s*(\\()([^)]*)(\\))\\s*(\\{)",
					"beginCaptures": {
						"1": {
							"name": "storage.type.deathshader"
						},
						"2": {
							"name": "entity.name.function.entry-point.fixed-function.deathshader"
						},
						"3": {
							"name": "punctuation.section.parens.begin.deathshader"
						},
						"4": {
							"name": "meta.fixed-function-targets.deathshader",
							"patterns": [
								{
									"match": "\\b(pvr|gx|pica|gu|gs|rdp|legacygl)\\b",
									"name": "constant.language.fixed-function-target.deathshader"
								},
								{
									"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
									"name": "invalid.illegal.fixed-function-target.deathshader"
								},
								{
									"match": ",",
									"name": "punctuation.separator.deathshader"
								}
							]
						},
						"5": {
							"name": "punctuation.section.parens.end.deathshader"
						},
						"6": {
							"name": "punctuation.section.block.begin.deathshader"
						}
					},
					"end": "^\\s*(\\})|(?=^(?:void|program|shader_type|batched|variant|render_mode|precision|attribute|varying|uniform|layout|struct)\\b)",
					"endCaptures": {
						"1": {
							"name": "punctuation.section.block.end.deathshader"
						}
					},
					"comment": "The second alternative is error recovery, and it is why a brace still missing while the block is being typed cannot paint the rest of the file as fixed-function: a top-level keyword at column 0 can only mean the block is over. Every statement of a body is indented, so it never fires on well-formed input.",
					"name": "meta.block.fixed-function.deathshader",
					"patterns": [
						{
							"include": "#fixed-function-body"
						}
					]
				},
				{
					"comment": "The same signature with its brace on the next line. The body then has no block scope - the rule above is the one that opens it - but the declaration itself still reads correctly instead of colouring as an ordinary function.",
					"match": "^\\s*(void)\\s+(fixed_function)\\s*(\\()([^)]*)(\\))\\s*$",
					"captures": {
						"1": {
							"name": "storage.type.deathshader"
						},
						"2": {
							"name": "entity.name.function.entry-point.fixed-function.deathshader"
						},
						"3": {
							"name": "punctuation.section.parens.begin.deathshader"
						},
						"4": {
							"name": "meta.fixed-function-targets.deathshader",
							"patterns": [
								{
									"match": "\\b(pvr|gx|pica|gu|gs|rdp|legacygl)\\b",
									"name": "constant.language.fixed-function-target.deathshader"
								},
								{
									"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
									"name": "invalid.illegal.fixed-function-target.deathshader"
								},
								{
									"match": ",",
									"name": "punctuation.separator.deathshader"
								}
							]
						},
						"5": {
							"name": "punctuation.section.parens.end.deathshader"
						}
					}
				},
				{
					"comment": "void vertex() / void fragment() - the GLSL entry points spliced into main()",
					"match": "^\\s*(void)\\s+(vertex|fragment)\\s*(\\()\\s*(\\))",
					"captures": {
						"1": {
							"name": "storage.type.deathshader"
						},
						"2": {
							"name": "entity.name.function.entry-point.deathshader"
						},
						"3": {
							"name": "punctuation.section.parens.begin.deathshader"
						},
						"4": {
							"name": "punctuation.section.parens.end.deathshader"
						}
					}
				}
			]
		},
		"fixed-function-block": {
			"comment": "One nested brace pair inside a fixed_function body. Without it the body's end pattern would take the first closing brace of an if or a for as the end of the whole block, and every statement after it would be scoped as ordinary GLSL. The end carries the same top-level-keyword recovery as the block itself, so an unclosed if does not swallow what follows either.",
			"begin": "\\{",
			"beginCaptures": {
				"0": {
					"name": "punctuation.section.block.begin.deathshader"
				}
			},
			"end": "\\}|(?=^(?:void|program|shader_type|batched|variant|render_mode|precision|attribute|varying|uniform|layout|struct)\\b)",
			"endCaptures": {
				"0": {
					"name": "punctuation.section.block.end.deathshader"
				}
			},
			"patterns": [
				{
					"include": "#fixed-function-body"
				}
			]
		},
		"fixed-function-body": {
			"comment": "The block is transpiled to C++ and run once per draw while a pass is built - it is not a shading language, so it deliberately does NOT include the GLSL built-ins. Only the maths subset the transpiler accepts colours as a built-in here; anything else reads as an ordinary call, which is what the hover says about it too.",
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#preprocessor"
				},
				{
					"include": "#fixed-function-block"
				},
				{
					"include": "#fixed-function-vocabulary"
				},
				{
					"comment": "The local types a block accepts: the GLSL scalar/vector subset. No matrices and no arrays.",
					"match": "\\b(void|bool|int|float|vec2|vec3|vec4)\\b",
					"name": "storage.type.deathshader"
				},
				{
					"comment": "The maths subset - transpiled to C++ and evaluated once per draw, not per pixel. float()/int() are constructors and colour as types above.",
					"match": "\\b(abs|ceil|clamp|cos|floor|max|min|mix|sin|sqrt)\\b(?=\\s*\\()",
					"name": "support.function.fixed-function.deathshader"
				},
				{
					"comment": "The instance colour the effect is drawn with - not the fragment output; a block never shades a pixel",
					"match": "\\bCOLOR\\b",
					"name": "variable.language.builtin.deathshader"
				},
				{
					"include": "#code-common"
				}
			]
		},
		"fixed-function-vocabulary": {
			"comment": "The fixed-function DSL. Every rule here is written so that it cannot fire on ordinary GLSL, because a .inc fragment holding a block's body is pasted into one and has no block of its own to sit in: the statements need their terminator, the pass fields need an assignment (they are write-only), and the two enum fields carry their value in the same match.",
			"patterns": [
				{
					"comment": "pipeline <name>; - binds the effect to a backend pipeline stage. Must be the block's first statement; passes may still follow it.",
					"match": "\\b(pipeline)\\s+(?:(tile_map_mesh|lighting_combine|line_strip_mesh)|([A-Za-z_][A-Za-z0-9_]*))\\s*(;)",
					"captures": {
						"1": {
							"name": "keyword.other.pipeline.deathshader"
						},
						"2": {
							"name": "support.constant.pipeline-intrinsic.deathshader"
						},
						"3": {
							"name": "invalid.illegal.pipeline-intrinsic.deathshader"
						},
						"4": {
							"name": "punctuation.terminator.deathshader"
						}
					}
				},
				{
					"comment": "pass <name>; - declares one bundle of hardware state, never with an initializer",
					"match": "\\b(pass)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(;)",
					"captures": {
						"1": {
							"name": "storage.type.pass.deathshader"
						},
						"2": {
							"name": "variable.other.pass.deathshader"
						},
						"3": {
							"name": "punctuation.terminator.deathshader"
						}
					}
				},
				{
					"match": "\\b(submit_quad|submit_strip|submit_strip_shaded)\\b(?=\\s*\\()",
					"name": "support.function.submit.deathshader"
				},
				{
					"match": "\\b(strip_position|strip_uv|strip_color)\\b(?=\\s*\\()",
					"name": "support.function.strip.deathshader"
				},
				{
					"comment": "Optional EffectContext facilities - the generated table records which ones an effect calls",
					"match": "\\b(texel_size|has_texel_size|quad_origin|quad_axis_x|quad_axis_y|has_uniform|uniform_float|uniform_vec2|uniform_vec4)\\b(?=\\s*\\()",
					"name": "support.function.context.deathshader"
				},
				{
					"comment": "p.blend and p.tev take a plain '=' assignment of one bare identifier from a fixed set, so the value belongs to the same match as the field - which is also what keeps these names from colouring anywhere else",
					"match": "(\\.)(blend)\\s*(=)\\s*(?:(MATERIAL|ADD|OPAQUE|ALPHA)|([A-Za-z_][A-Za-z0-9_]*))\\b",
					"captures": {
						"1": {
							"name": "punctuation.accessor.deathshader"
						},
						"2": {
							"name": "variable.other.property.pass-field.deathshader"
						},
						"3": {
							"name": "keyword.operator.deathshader"
						},
						"4": {
							"name": "constant.language.blend-mode.deathshader"
						},
						"5": {
							"name": "invalid.illegal.blend-mode.deathshader"
						}
					}
				},
				{
					"match": "(\\.)(tev)\\s*(=)\\s*(?:(MODULATE_X2|MODULATE_X4|MODULATE|SILHOUETTE|TINT_MIX|LUMA_RAMP)|([A-Za-z_][A-Za-z0-9_]*))\\b",
					"captures": {
						"1": {
							"name": "punctuation.accessor.deathshader"
						},
						"2": {
							"name": "variable.other.property.pass-field.deathshader"
						},
						"3": {
							"name": "keyword.operator.deathshader"
						},
						"4": {
							"name": "constant.language.tev-preset.deathshader"
						},
						"5": {
							"name": "invalid.illegal.tev-preset.deathshader"
						}
					}
				},
				{
					"comment": "The remaining pass fields: color (vec4), offset_color (vec3), screen_offset (vec2), luma_gain (float). All of them are write-only, so requiring the assignment is exact rather than merely defensive.",
					"match": "(\\.)(color|offset_color|screen_offset|luma_gain)\\s*(?=[-+*/]?=[^=])",
					"captures": {
						"1": {
							"name": "punctuation.accessor.deathshader"
						},
						"2": {
							"name": "variable.other.property.pass-field.deathshader"
						}
					}
				}
			]
		},
		"code": {
			"comment": "The GLSL stages. Everything here is stage vocabulary - a fixed_function body shares only #code-common.",
			"patterns": [
				{
					"comment": "Referencing fragColor is a parse error - COLOR is the fragment output variable itself",
					"match": "\\bfragColor\\b",
					"name": "invalid.illegal.frag-color.deathshader"
				},
				{
					"comment": "Canvas-mode built-ins; also the fragment output in custom mode (COLOR)",
					"match": "\\b(COLOR|UV|VERTEX|PALETTE_OFFSET|TEXTURE)\\b",
					"name": "variable.language.builtin.deathshader"
				},
				{
					"comment": "Canvas built-ins the compiler reports as unsupported",
					"match": "\\b(NORMAL|SCREEN_UV|SCREEN_PIXEL_SIZE|TIME|POINT_COORD)\\b",
					"name": "invalid.deprecated.unsupported-builtin.deathshader"
				},
				{
					"match": "\\bgl_(Position|VertexID|InstanceID|FragCoord|FragDepth|PointSize|PointCoord|FrontFacing|ClipDistance|VertexIndex|InstanceIndex)\\b",
					"name": "variable.language.gl.deathshader"
				},
				{
					"comment": "GLSL built-in functions",
					"match": "\\b(abs|acos|acosh|all|any|asin|asinh|atan|atanh|bitCount|ceil|clamp|cos|cosh|cross|degrees|determinant|dFdx|dFdy|distance|dot|equal|exp|exp2|faceforward|floatBitsToInt|floatBitsToUint|floor|fma|fract|fwidth|greaterThan|greaterThanEqual|intBitsToFloat|inverse|inversesqrt|isinf|isnan|length|lessThan|lessThanEqual|log|log2|matrixCompMult|max|min|mix|mod|modf|normalize|not|notEqual|outerProduct|pow|radians|reflect|refract|round|roundEven|sign|sin|sinh|smoothstep|sqrt|step|tan|tanh|texelFetch|texture|textureGrad|textureLod|textureProj|textureSize|transpose|trunc|uintBitsToFloat)\\b(?=\\s*\\()",
					"name": "support.function.glsl.deathshader"
				},
				{
					"match": "\\b(void|bool|int|uint|float|double|vec2|vec3|vec4|bvec2|bvec3|bvec4|ivec2|ivec3|ivec4|uvec2|uvec3|uvec4|mat2|mat3|mat4|mat2x2|mat2x3|mat2x4|mat3x2|mat3x3|mat3x4|mat4x2|mat4x3|mat4x4|sampler2D|sampler2DArray|sampler3D|samplerCube|isampler2D|usampler2D|sampler2DShadow)\\b",
					"name": "storage.type.deathshader"
				},
				{
					"match": "\\b(const|in|out|inout|uniform|varying|attribute|flat|smooth|noperspective|centroid|invariant|layout|struct|precision|lowp|mediump|highp)\\b",
					"name": "storage.modifier.deathshader"
				},
				{
					"comment": "The variant/config macros that pass through textually",
					"match": "\\b(GL_ES|BATCH_SIZE)\\b",
					"name": "support.constant.deathshader"
				},
				{
					"include": "#code-common"
				}
			]
		},
		"code-common": {
			"comment": "What the GLSL stages and a fixed_function body genuinely share: comments, the preprocessor, C control flow, literals and operators",
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#preprocessor"
				},
				{
					"match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|discard)\\b",
					"name": "keyword.control.deathshader"
				},
				{
					"match": "\\b(true|false)\\b",
					"name": "constant.language.boolean.deathshader"
				},
				{
					"include": "#numbers"
				},
				{
					"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()",
					"name": "entity.name.function.call.deathshader"
				},
				{
					"match": "(\\.)([xyzwrgbastpq]{1,4})\\b",
					"captures": {
						"1": {
							"name": "punctuation.accessor.deathshader"
						},
						"2": {
							"name": "variable.other.member.swizzle.deathshader"
						}
					}
				},
				{
					"include": "#operators"
				},
				{
					"match": ";",
					"name": "punctuation.terminator.deathshader"
				}
			]
		},
		"numbers": {
			"comment": "The lookbehind is what \\b cannot express: it keeps the 0 of an identifier like x0 and the 5 of a swizzle-looking member out, while still taking a leading-dot float after an operator",
			"match": "(?<![\\w.])(?:0[xX][0-9a-fA-F]+[uU]?|(?:\\d+\\.\\d*|\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?[fF]?[uU]?)",
			"name": "constant.numeric.deathshader"
		},
		"operators": {
			"match": "<<|>>|\\+\\+|--|&&|\\|\\||[-+*/%<>=!&^|~?:]",
			"name": "keyword.operator.deathshader"
		}
	}
}
