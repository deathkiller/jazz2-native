; PICA200 vertex program of the PICA rendering backend (Sources/nCine/Graphics/RHI/PICA)
;
; The backend transforms every primitive on the CPU into screen pixels and texel coordinates exactly like
; the GU backend does for the PSP's "through" mode, so the one thing left for the programmable vertex
; stage is to map those screen coordinates into clip space - with the orthographic matrix the device
; builds with Mtx_OrthoTilt() for the top screen (whose framebuffer is rotated by 90 degrees) or with
; Mtx_Ortho() for a render-to-texture pass - and to hand the texture coordinates and the colour through.
; The colour arrives as four unsigned bytes and the PICA200 does not normalize a fixed-point attribute, so
; the division by 255 happens here. Assembled by picasso at build time (see cmake/ncine_extra_sources.cmake).

; Uniforms
.fvec projection[4]

; Constants
.constf consts(0.0, 1.0, 0.003921568393707275390625, 0.0)
.alias  inv255 consts.zzzz  ; 1/255 as the nearest float24

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color

; Inputs
.alias inpos v0  ; x, y in screen pixels (float2)
.alias intex v1  ; u, v normalized to the bound page (float2)
.alias inclr v2  ; r, g, b, a (four unsigned bytes)

.entry sprite_main
.proc sprite_main
	; r0 = vec4(inpos.xy, 0.0, 1.0)
	mov r0.xy, inpos.xy
	mov r0.zw, consts.xxxy

	; outpos = projection * r0
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov outtc0, intex
	mul outclr, inv255, inclr

	end
.end
